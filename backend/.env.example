# Development only; bind Uvicorn to 127.0.0.1, not 0.0.0.0.
SENTINEL_ENVIRONMENT=local
SENTINEL_DATABASE_URL=sqlite:///artifacts/sentinel.db
SENTINEL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SENTINEL_LOG_LEVEL=INFO
# Reads require no secrets in this local-only Phase 3 prototype.
# Registration/ingestion stay disabled unless an operator token and workspace are configured.
# Generate the token locally; never put it in frontend environment variables or Git.
# SENTINEL_OPERATOR_TOKEN=<independently-generated-32-or-more-character-secret>
# SENTINEL_ARTIFACT_ROOT=artifacts/content
# SENTINEL_DEMO_ROOT=demo_workspaces
# SENTINEL_PERMITTED_WORKSPACES={"demo":{"name":"Local sample","revision":"demo-v1","snapshot_key":"snapshots/demo-v1.zip","supported_errors":["KeyError"]}}
