# ?? Sentinel AI Backend ? Environment Example ??????????????????????????????
# Copy to .env and fill in real values. Never commit .env.

# Server
APP_ENV=development
SECRET_KEY=change-me-to-a-random-32-char-secret
SESSION_MAX_AGE_SECONDS=86400
CORS_ALLOW_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Demo workspace (server-side only ? never sent to frontend)
DEMO_APP_ID=app_demo
DEMO_WORKSPACE_PATH=demo_app/workspace

# LLM provider (optional ? diagnosis/repair stubs work without it)
LLM_PROVIDER=stub
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# Agent timeouts (seconds)
AGENT_TIMEOUT_SECONDS=120
MAX_CANDIDATE_REVISIONS=2
MONITORING_INTERVAL_SECONDS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
